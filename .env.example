# The loopback /admin page normally creates and updates project .env.
# Never commit the real file. Existing process variables override file values.
MPE_AI_API_KEY=
MPE_ACTIVE_PROVIDER=mock
MPE_ACTIVE_MODEL=schema-sample-v1

# Stable runtime root. Relative paths below resolve from this directory.
MPE_HOME=~/.model-processing-engine
# /admin writes an absolute project-local providers.local.json path here.
MPE_PROVIDER_CONFIG=
MPE_DATA_DIR=data/runtime
MPE_LOG_DIR=logs
MPE_RUN_DIR=run
MPE_HOST=127.0.0.1
MPE_PORT=8787
MPE_MAX_PROVIDER_CONCURRENCY=64
# Enforced against the actual received body, including chunked requests.
MPE_MAX_REQUEST_BYTES=2097152
MPE_ASYNC_WORKERS=4
MPE_ASYNC_QUEUE_CAPACITY=100

# Optional on loopback; required when binding to a non-loopback address.
MPE_API_TOKEN=

# Remote binding is rejected unless this is explicitly enabled.
MPE_ALLOW_REMOTE=0
