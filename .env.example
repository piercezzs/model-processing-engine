# Provider secrets are read only from environment variables.
MPE_AI_API_KEY=

# Runtime configuration.
MPE_PROVIDER_CONFIG=config/providers.json
MPE_DATA_DIR=data/runtime
MPE_HOST=127.0.0.1
MPE_PORT=8787
MPE_MAX_PROVIDER_CONCURRENCY=8
MPE_MAX_REQUEST_BYTES=2097152

# Optional on loopback; required when binding to a non-loopback address.
MPE_API_TOKEN=

# Remote binding is rejected unless this is explicitly enabled.
MPE_ALLOW_REMOTE=0
